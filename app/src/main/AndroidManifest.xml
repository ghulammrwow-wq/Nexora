<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TokenRoomDatabase">

        <!-- LOGIN -->

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- SIGNUP -->

        <activity
            android:name=".ui.signup.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- HOME -->

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- UPLOAD DOCUMENTARY -->

        <activity
            android:name=".ui.home.UploadDocumentaryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- FAVORITE -->

        <activity
            android:name=".ui.home.FavoriteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- SPLASH / LAUNCHER -->

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.home.PostTextActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- EDIT IMAGE -->

        <activity
            android:name=".ui.home.EditImageActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- EDIT USERNAME -->

        <activity
            android:name=".ui.home.EditUsernameActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- EDIT NAME -->

        <activity
            android:name=".ui.home.EditNameActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- EDIT EMAIL -->

        <activity
            android:name=".ui.home.EditEmailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- EDIT GENDER -->

        <activity
            android:name=".ui.home.EditGenderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.home.EditTextPostActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.home.FullScreenVideoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>