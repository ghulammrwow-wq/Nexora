<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <!-- PROFILE IMAGE + USERNAME -->

        <LinearLayout
            android:id="@+id/profileSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDrawerProfile"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Profile Image"
                app:shapeAppearanceOverlay="@style/CircularImage" />

            <TextView
                android:id="@+id/tvDrawerUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Username"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


        <!-- NAME -->

        <TextView
            android:id="@+id/tvDrawerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Ghulam Mustafa"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:clickable="true"
            android:focusable="true" />


        <!-- EMAIL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/mail_icon"
                android:contentDescription="Email"
                app:tint="@color/blue" />

            <TextView
                android:id="@+id/tvDrawerEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="ali@gmail.com"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


        <!-- GENDER -->

        <LinearLayout
            android:id="@+id/genderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivGender"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/person_icon"
                android:contentDescription="Gender"
                app:tint="@color/blue" />

            <TextView
                android:id="@+id/tvDrawerGender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Male"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#E5E5E5" />


        <!-- DELETE + LOGOUT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- DELETE ACCOUNT -->

            <Button
                android:id="@+id/btnDrawerDelete"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Delete Account"
                android:backgroundTint="@color/blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:singleLine="true"
                android:ellipsize="none" />

            <!-- LOGOUT -->

            <Button
                android:id="@+id/btnDrawerLogout"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Logout"
                android:backgroundTint="@color/blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>