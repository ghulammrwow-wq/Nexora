<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"

    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">

        <!-- ============================================== -->
        <!-- PROFILE ROW -->
        <!-- ============================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Number bubble -->
            <TextView
                android:id="@+id/tvNumber"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/number_bubble"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDocumentaryProfile"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="centerCrop"
                android:src="@drawable/person_icon"
                app:shapeAppearanceOverlay="@style/CircularImage" />

            <TextView
                android:id="@+id/tvDocumentaryUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="User"
                android:textSize="11sp"
                android:textStyle="bold" />




            <!-- Delete -->
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:padding="6dp"
                android:src="@drawable/close_icon" />

        </LinearLayout>

        <!-- ============================================== -->
        <!-- TITLE -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/tvDocumentaryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"

            android:ellipsize="end"
            android:maxLines="1"

            android:text="Documentary Title"
            android:textSize="12sp"
            android:textStyle="bold"

            android:visibility="gone" />

        <!-- ============================================== -->
        <!-- DESCRIPTION -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/tvDocumentaryDescription"
            android:layout_width="match_parent"
            android:layout_height="90dp"




            android:background="#F3F4F6"
            android:padding="8dp"

            android:gravity="top|start"

            android:maxLines="4"
            android:ellipsize="end"

            android:textSize="12sp"
            android:textColor="#333333"

            android:visibility="gone" />

        <!-- ============================================== -->
        <!-- MEDIA CONTAINER -->
        <!-- ============================================== -->

        <FrameLayout
            android:id="@+id/layoutMediaContainer"
            android:layout_width="match_parent"
            android:layout_height="90dp">

            <!-- IMAGE -->

            <ImageView
                android:id="@+id/ivDocumentaryMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:scaleType="centerCrop"

                android:visibility="gone" />

            <!-- VIDEO -->

            <FrameLayout
                android:id="@+id/layoutVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivVideoThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#1A1A1A" />

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_circle"
                    android:contentDescription="Play Video" />

            </FrameLayout>

            <androidx.media3.ui.PlayerView
                android:id="@+id/videoDocumentary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                app:resize_mode="zoom"
                app:use_controller="false"
                android:visibility="gone" />

            <!-- PDF -->

            <!-- PDF -->

            <LinearLayout
                android:id="@+id/layoutPdf"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/pdf"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/tvPdfName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:gravity="center"
                    android:text="PDF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

        <!-- ============================================== -->
        <!-- ACTIONS -->
        <!-- ============================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"

            android:gravity="center_vertical"

            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="Favorite"

                android:padding="6dp"

                android:src="@drawable/heart_outline" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="32dp"
                android:layout_height="32dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="Share"

                android:padding="6dp"

                android:src="@drawable/ic_share" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>