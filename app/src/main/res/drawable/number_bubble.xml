<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer border -->
    <item>
        <shape android:shape="oval">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="1dp"
                android:color="#D9DEE7" />

        </shape>
    </item>

    <!-- Inner circle -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="oval">

            <solid android:color="#EEF2F7" />

        </shape>
    </item>

</layer-list>